# Copy to .env.local for development.

# Absolute address of the deployed site, used for social sharing tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The Calendly event embedded in the booking section of the homepage (/#book-consultation).
NEXT_PUBLIC_CALENDLY_EVENT_URL=https://calendly.com/neuroadvancements/30min

# "true" shows the live calendar. Leave as "false" on the public site until
# professional authorization, privacy arrangements, and the clinical workflow are confirmed.
NEXT_PUBLIC_BOOKING_ENABLED=false

# "true" opens the email signup forms. Leave unset until a mailing provider is
# connected in app/api/subscribe/route.ts. While unset the forms are shown closed.
NEXT_PUBLIC_SIGNUPS_ENABLED=false

# "true" allows the ?motion=reduce and ?webgl=off review switches in a production build.
# Leave unset on the public site.
NEXT_PUBLIC_QA_SWITCHES=false
